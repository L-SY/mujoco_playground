<mujoco model="WF_TRON1A">
  <compiler angle="radian" autolimits="true"/>

  <option iterations="3" ls_iterations="5" timestep=".002" integrator="Euler">
    <flag eulerdamp="disable"/>
  </option>

  <asset>
    <material name="body_gray" rgba="0.79216 0.81961 0.93333 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="wheel_dark" rgba="0.26667 0.26667 0.26667 1"/>

    <mesh name="base_Link" file="assets/base_Link.STL"/>
    <mesh name="abad_L_Link" file="assets/abad_L_Link.STL"/>
    <mesh name="hip_L_Link" file="assets/hip_L_Link.STL"/>
    <mesh name="knee_L_Link" file="assets/knee_L_Link.STL"/>
    <mesh name="wheel_L_Link" file="assets/wheel_L_Link.STL"/>
    <mesh name="abad_R_Link" file="assets/abad_R_Link.STL"/>
    <mesh name="hip_R_Link" file="assets/hip_R_Link.STL"/>
    <mesh name="knee_R_Link" file="assets/knee_R_Link.STL"/>
    <mesh name="wheel_R_Link" file="assets/wheel_R_Link.STL"/>
  </asset>

  <default>
    <default class="wf_tron1a">
      <geom condim="1" contype="0" conaffinity="0"/>
      <site rgba="1 0 0 1" size="0.01" group="5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
        <default class="wheel_contact">
          <geom contype="2" conaffinity="1" type="cylinder" condim="4"
                friction="0.8 0.005 0.0001"/>
        </default>
      </default>

      <joint frictionloss="0.05" armature="0.01"/>

      <default class="abad">
        <joint axis="1 0 0" actuatorfrcrange="-80 80" damping="1"/>
      </default>
      <default class="hip">
        <joint axis="0 1 0" actuatorfrcrange="-80 80" damping="1"/>
      </default>
      <default class="knee">
        <joint axis="0 1 0" actuatorfrcrange="-80 80" damping="1"/>
      </default>
      <default class="wheel">
        <joint axis="0 1 0" actuatorfrcrange="-40 40" damping="0.05" frictionloss="0.01"/>
      </default>
    </default>
  </default>

  <worldbody>
    <light name="spotlight" mode="targetbodycom" target="base_Link" pos="0 -2 4" exponent="20"/>
    <body name="base_Link" pos="0 0 0.92" childclass="wf_tron1a">
      <freejoint/>
      <inertial pos="0.0457123 0.000139854 -0.163809" quat="0.972578 -0.00615364 -0.232461 0.00398682"
                mass="9.595" diaginertia="0.154712 0.11093 0.0846371"/>
      <site name="imu" pos="0 0 0"/>
      <camera name="track" pos="1.5 -1.2 0.8" xyaxes="0.628 0.779 0 -0.274 0.221 0.936" mode="trackcom"/>
      <geom class="visual" material="body_gray" mesh="base_Link"/>
      <geom class="collision" name="base_collision" size="0.135 0.13 0.095" pos="0.03 0 -0.072" type="box"/>

      <!-- Left Leg -->
      <body name="abad_L_Link" pos="0.05556 0.105 -0.2602">
        <inertial pos="-0.06977 0.04479 0.00057" quat="0.595024 0.579772 0.394141 0.393019"
                  mass="1.469" diaginertia="0.00252289 0.00208104 0.00139163"/>
        <joint name="abad_L_Joint" class="abad" range="-0.38397 1.39626"/>
        <geom class="visual" material="body_gray" mesh="abad_L_Link"/>
        <geom class="collision" name="abad_L_collision" type="cylinder" pos="-0.08 0 0"
              euler="1.57 0 0" size="0.05 0.025"/>

        <body name="hip_L_Link" pos="-0.077 0.0205 0">
          <inertial pos="-0.02869 -0.0477 -0.03992" quat="0.853885 0.192797 0.226903 0.426877"
                    mass="2.3" diaginertia="0.0233264 0.0230229 0.00277548"/>
          <joint name="hip_L_Joint" class="hip" range="-1.01229 1.39626"/>
          <geom class="visual" material="white" mesh="hip_L_Link"/>
          <geom class="collision" name="hip_L_collision" type="cylinder" pos="-0.1 -0.025 -0.14"
                euler="0 0.53 0" size="0.035 0.075"/>

          <body name="knee_L_Link" pos="-0.15 -0.0205 -0.25981">
            <inertial pos="0.11913 0.01106 -0.20363" quat="0.687012 -0.159981 -0.201582 0.679548"
                      mass="1.49" diaginertia="0.0177107 0.0171855 0.001015"/>
            <joint name="knee_L_Joint" class="knee" axis="0 -1 0" range="-0.872665 1.36136"/>
            <geom class="visual" material="body_gray" mesh="knee_L_Link"/>
            <geom class="collision" name="knee_L_collision" type="cylinder" pos="0.078 0 -0.12"
                  euler="0 -0.55 0" size="0.015 0.13"/>

            <body name="wheel_L_Link" pos="0.15 0.0435 -0.25981">
              <inertial pos="3e-05 0.00807 -2e-05" quat="0.683013 0.183016 0.183017 0.683011"
                        mass="1.08" diaginertia="0.00974272 0.00515568 0.00515344"/>
              <joint name="wheel_L_Joint" class="wheel" limited="false"/>
              <geom class="visual" material="wheel_dark" mesh="wheel_L_Link"/>
              <geom class="wheel_contact" name="wheel_L_contact" pos="0.0 0.008 0.0"
                    size="0.127 0.025" quat="0.707107 0.707107 0 0"/>
              <site name="wheel_L" pos="0 0.008 0"/>
            </body>
          </body>
        </body>
      </body>

      <!-- Right Leg -->
      <body name="abad_R_Link" pos="0.05556 -0.105 -0.2602">
        <inertial pos="-0.06977 -0.04479 0.00057" quat="0.393019 0.394141 0.579772 0.595024"
                  mass="1.469" diaginertia="0.00252289 0.00208104 0.00139163"/>
        <joint name="abad_R_Joint" class="abad" range="-1.39626 0.38397"/>
        <geom class="visual" material="body_gray" mesh="abad_R_Link"/>
        <geom class="collision" name="abad_R_collision" type="cylinder" pos="-0.08 0 0"
              euler="1.57 0 0" size="0.05 0.025"/>

        <body name="hip_R_Link" pos="-0.077 -0.0205 0">
          <inertial pos="-0.02869 0.0477 -0.03992" quat="0.426877 0.226903 0.192797 0.853885"
                    mass="2.3" diaginertia="0.0233264 0.0230229 0.00277548"/>
          <joint name="hip_R_Joint" class="hip" axis="0 -1 0" range="-1.39626 1.01229"/>
          <geom class="visual" material="white" mesh="hip_R_Link"/>
          <geom class="collision" name="hip_R_collision" type="cylinder" pos="-0.10 0.025 -0.14"
                euler="0 0.53 0" size="0.035 0.075"/>

          <body name="knee_R_Link" pos="-0.15 0.0205 -0.25981">
            <inertial pos="0.11913 -0.01106 -0.20363" quat="0.679548 -0.201582 -0.159981 0.687012"
                      mass="1.49" diaginertia="0.0177107 0.0171855 0.001015"/>
            <joint name="knee_R_Joint" class="knee" range="-1.36136 0.872665"/>
            <geom class="visual" material="body_gray" mesh="knee_R_Link"/>
            <geom class="collision" name="knee_R_collision" type="cylinder" pos="0.078 0 -0.12"
                  euler="0 -0.55 0" size="0.015 0.13"/>

            <body name="wheel_R_Link" pos="0.15 -0.0435 -0.25981">
              <inertial pos="3e-05 -0.00807 -2e-05" quat="0.683011 0.183017 0.183016 0.683013"
                        mass="1.08" diaginertia="0.00974272 0.00515568 0.00515344"/>
              <joint name="wheel_R_Joint" class="wheel" limited="false"/>
              <geom class="visual" material="wheel_dark" mesh="wheel_R_Link"/>
              <geom class="wheel_contact" name="wheel_R_contact" pos="0.0 -0.008 0.0"
                    size="0.127 0.025" quat="0.707107 0.707107 0 0"/>
              <site name="wheel_R" pos="0 -0.008 0"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <gyro site="imu" name="gyro"/>
    <velocimeter site="imu" name="local_linvel"/>
    <accelerometer site="imu" name="accelerometer"/>
    <framezaxis objtype="site" objname="imu" name="upvector"/>
    <framelinvel objtype="site" objname="imu" name="global_linvel"/>
    <frameangvel objtype="site" objname="imu" name="global_angvel"/>
    <framepos objtype="site" objname="imu" name="position"/>
    <framequat objtype="site" objname="imu" name="orientation"/>
    <framelinvel objtype="site" objname="wheel_L" name="wheel_L_global_linvel"/>
    <framelinvel objtype="site" objname="wheel_R" name="wheel_R_global_linvel"/>
  </sensor>

  <actuator>
    <motor name="abad_L_Joint" gear="1" joint="abad_L_Joint" ctrllimited="true" ctrlrange="-80 80"/>
    <motor name="hip_L_Joint" gear="1" joint="hip_L_Joint" ctrllimited="true" ctrlrange="-80 80"/>
    <motor name="knee_L_Joint" gear="1" joint="knee_L_Joint" ctrllimited="true" ctrlrange="-80 80"/>
    <motor name="wheel_L_Joint" gear="1" joint="wheel_L_Joint" ctrllimited="true" ctrlrange="-40 40"/>
    <motor name="abad_R_Joint" gear="1" joint="abad_R_Joint" ctrllimited="true" ctrlrange="-80 80"/>
    <motor name="hip_R_Joint" gear="1" joint="hip_R_Joint" ctrllimited="true" ctrlrange="-80 80"/>
    <motor name="knee_R_Joint" gear="1" joint="knee_R_Joint" ctrllimited="true" ctrlrange="-80 80"/>
    <motor name="wheel_R_Joint" gear="1" joint="wheel_R_Joint" ctrllimited="true" ctrlrange="-40 40"/>
  </actuator>
</mujoco>
